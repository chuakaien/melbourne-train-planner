[Unit]
Description=Weekly Melbourne Transport Radar timetable refresh

[Timer]
# Sunday 03:30 in Melbourne; Persistent catches up after server downtime.
OnCalendar=Sun *-*-* 03:30:00 Australia/Melbourne
Persistent=true
RandomizedDelaySec=15m
Unit=melbourne-transport-radar-refresh.service

[Install]
WantedBy=timers.target


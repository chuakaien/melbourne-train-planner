[Unit]
Description=Refresh Melbourne Transport Radar GTFS timetable data
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=chuakaien
Group=chuakaien
WorkingDirectory=/var/www/melbourne-train-planner
ExecStart=/var/www/melbourne-train-planner/scripts/home-gtfs-refresh.sh
TimeoutStartSec=90min
Nice=10
UMask=0027


# Copy to .env.home on the server. This file is deliberately ignored by Git.
# The Compose stack turns these values into an internal PostgreSQL URL.
POSTGRES_DB=melbourne_transit_radar
POSTGRES_USER=melbourne_transit_radar
POSTGRES_PASSWORD=replace-with-a-long-random-password
ACTIVE_DATABASE=melbourne_transit_radar
IMPORT_DATABASE=melbourne_transit_radar_staging
# Optional: enables official GTFS-Realtime feeds when supplied.
TRANSPORT_VIC_GTFSR_API_KEY=
